<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: GPL-3.0-or-later. Copyright (C) 2026 k33bs -->
<plist version="1.0">
<dict>
	<!-- hardened runtime: capture devices count as cameras, their sound as a microphone -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- the blackmagic desktop video runtime is loaded from /Library/Frameworks and signed by its vendor -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
